    updated_at  TIMESTAMP    NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_dead_letters_status_retry ON dead_letters (status, next_retry_at);
CREATE INDEX idx_dead_letters_task_type ON dead_letters (task_type);


