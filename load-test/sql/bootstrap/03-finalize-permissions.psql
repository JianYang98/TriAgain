\set ON_ERROR_STOP on
-- PGDATABASE=triagain_dbb PGUSER=triagain PGSSLMODE=require 로 별도 접속.
BEGIN;
DO $$
BEGIN
  IF current_database() <> 'triagain_dbb' OR current_user <> 'triagain' THEN
    RAISE EXCEPTION 'Unexpected finalization database/user';
  END IF;
END $$;
REVOKE CREATE ON SCHEMA public FROM triagain_dbb_app;
COMMIT;
SELECT rolname, rolsuper, rolcreatedb, rolcreaterole, rolreplication, rolbypassrls
FROM pg_roles WHERE rolname='triagain_dbb_app';
SELECT has_database_privilege('triagain_dbb_app','triagain_dbb','CONNECT') AS can_connect,
       has_database_privilege('triagain_dbb_app','triagain_dbb','CREATE') AS can_create_schema,
       has_database_privilege('triagain_dbb_app','triagain_dbb','TEMP') AS can_create_temp,
       has_schema_privilege('triagain_dbb_app','public','USAGE') AS schema_usage,
       has_schema_privilege('triagain_dbb_app','public','CREATE') AS schema_create;

-- 실험 테이블별 권한 결과: 소유자=triagain_dbb_app, 모든 boolean=true 기대.
SELECT c.relname, pg_get_userbyid(c.relowner) AS owner,
       has_table_privilege('triagain_dbb_app',c.oid,'SELECT') AS can_select,
       has_table_privilege('triagain_dbb_app',c.oid,'INSERT') AS can_insert,
       has_table_privilege('triagain_dbb_app',c.oid,'UPDATE') AS can_update,
       has_table_privilege('triagain_dbb_app',c.oid,'DELETE') AS can_delete
FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
WHERE n.nspname='public' AND c.relkind IN ('r','p') ORDER BY c.relname;
-- 시퀀스별 권한 결과: 소유자=triagain_dbb_app, 모든 boolean=true 기대.
SELECT c.relname, pg_get_userbyid(c.relowner) AS owner,
       has_sequence_privilege('triagain_dbb_app',c.oid,'USAGE') AS can_use,
       has_sequence_privilege('triagain_dbb_app',c.oid,'SELECT') AS can_select,
       has_sequence_privilege('triagain_dbb_app',c.oid,'UPDATE') AS can_update
FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
WHERE n.nspname='public' AND c.relkind='S' ORDER BY c.relname;
