  "templating": {
    "list": [
      {
        "name": "method",
        "label": "Method",
        "type": "query",
        "description": "HTTP 완료율과 응답시간에 적용할 메서드를 선택합니다.",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
