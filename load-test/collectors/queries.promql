# 이름|PromQL — prom-export.sh가 줄마다 prom-<이름>.json(query_range, step=1s)으로 덤프한다. 첫 '|'만 구분자다.
# 지표 이름은 measurement-contract §2-S의 과거 scrape 이름이다 — G1 라이브 확인 전 [미확인]. G1 뒤 이름을 확정한다.
# node_로 시작하는 이름은 I5(◐ 비차단): 실패·빈 결과는 경고(코드 3). 나머지는 실패(코드 2).
# [5s] 창: 1초 scrape에서 창마다 표본이 약 5개다 — 짧은 창의 분위수는 표본 부족으로 흔들린다.
# HTTP 식은 uri!~"/actuator.*"로 1초 scrape 요청 자체를 뺀다. *_raw는 사후에 창을 바꿔 다시 계산할 원시 누적값이다.
# --- S1 Tomcat
tomcat_busy|tomcat_threads_busy_threads
tomcat_current|tomcat_threads_current_threads
tomcat_max|tomcat_threads_config_max_threads
# --- S2·S3 Hikari
hikari_active|hikaricp_connections_active
hikari_idle|hikaricp_connections_idle
hikari_pending|hikaricp_connections_pending
hikari_max|hikaricp_connections_max
hikari_acquire_p95|histogram_quantile(0.95, sum(rate(hikaricp_connections_acquire_seconds_bucket[5s])) by (le))
hikari_acquire_bucket_raw|sum by (le) (hikaricp_connections_acquire_seconds_bucket)
# --- S4 HTTP
http_p95|histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri!~"/actuator.*"}[5s])) by (le, status))
http_p99|histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri!~"/actuator.*"}[5s])) by (le, status))
http_rate|sum(rate(http_server_requests_seconds_count{uri!~"/actuator.*"}[5s])) by (status)
http_count_raw|sum by (status, uri) (http_server_requests_seconds_count{uri!~"/actuator.*"})
http_bucket_raw|sum by (le, status) (http_server_requests_seconds_bucket{uri!~"/actuator.*"})
# --- S5 JVM·GC·CPU
gc_pause_rate|rate(jvm_gc_pause_seconds_sum[5s])
gc_pause_sum_raw|jvm_gc_pause_seconds_sum
gc_pause_count_raw|jvm_gc_pause_seconds_count
heap_used|jvm_memory_used_bytes{area="heap"}
heap_max|jvm_memory_max_bytes{area="heap"}
process_cpu|process_cpu_usage
system_cpu|system_cpu_usage
# --- scrape 상태 (결손 초 확인 — 비교 그래프 8)
up|up
scrape_duration|scrape_duration_seconds
scrape_samples|scrape_samples_scraped
# --- I5 node_exporter (◐)
node_cpu|sum by (instance, mode) (rate(node_cpu_seconds_total{mode!="idle"}[5s]))
node_cpu_raw|node_cpu_seconds_total
node_mem_avail|node_memory_MemAvailable_bytes
node_mem_total|node_memory_MemTotal_bytes
node_swap_used|node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes
node_swap_in|rate(node_vmstat_pswpin[5s])
node_swap_out|rate(node_vmstat_pswpout[5s])
node_load1|node_load1
